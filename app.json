{
  "expo": {
    "name": "Journalizer",
    "slug": "Journalizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/image/journalizer-icon-cropped.png",
    "userInterfaceStyle": "light",
    "scheme": "journalizer",
    "splash": {
      "image": "./src/assets/image/journalizer-splash-screen-4.png",
      "resizeMode": "cover",
      "backgroundColor": "#ddd7e2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Journalizer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/image/journalizer-icon-cropped.png",
        "backgroundColor": "#ddd7e2"
      },
      "package": "com.anonymous.Journalizer",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.googleusercontent.apps.1024390295547-tkmrp282r8dv9qparg6ufi5u9kr76p1g",
              "host": "oauth2redirect",
              "pathPrefix": "/google"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./src/assets/image/journalizer-icon-cropped.png"
    },
    "plugins": [
      [
        "expo-font"
      ],
      [
        "expo-sqlite"
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/image/journalizer-splash-screen-4.png",
          "resizeMode": "cover",
          "backgroundColor": "#ddd7e2"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "44a0b814-74db-439a-80b8-48ed76cfb8cd"
      }
    }
  }
}
